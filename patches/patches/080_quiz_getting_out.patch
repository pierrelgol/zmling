+/// One step, no loop: the number that comes after n.
+fn nextNumber(n: zml.Tensor) zml.Tensor {
+    const two = zml.Tensor.scalar(2, .i32);
+    const even = n.remainder(two).cmp(.EQ, zml.Tensor.scalar(0, .i32));
+    return even.select(n.div(two), n.scale(3).addConstant(1));
+}
+
+const Escape = struct {
+    patience: i32,
+
+    pub const State = struct {
+        n: zml.Tensor,
+        steps: zml.Tensor,
+    };
+
+    pub fn cond(self: Escape, state: State) zml.Tensor {
+        const not_free = state.n.cmp(.NE, zml.Tensor.scalar(1, .i32));
+        const still_patient = state.steps.cmp(.LT, zml.Tensor.scalar(self.patience, .i32));
+        return not_free.logical(.AND, still_patient);
+    }
+
+    pub fn body(self: Escape, state: State) State {
+        _ = self;
+        return .{
+            .n = nextNumber(state.n),
+            .steps = state.steps.addConstant(1),
+        };
+    }
+};
 
