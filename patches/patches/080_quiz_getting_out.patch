+/// The number of steps taken from `start`, at most `patience`.
+fn stepsToFreedom(start: zml.Tensor, patience: i32) zml.Tensor {
+    const end = zml.ops.@"while"(Escape, .{ .patience = patience }, .{
+        .n = start,
+        .steps = zml.Tensor.scalar(0, .i32),
+    });
+    return end.steps;
+}
 
