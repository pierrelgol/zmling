 /// The layer norm of the lesson, by hand, with an eps of 1e-5.
 /// x: {.cake, .d}, weight and bias: {.d}. Returns {.cake, .d}.
 fn levelByHand(x: zml.Tensor, weight: zml.Tensor, bias: zml.Tensor) zml.Tensor {
-    return ???;
+    const centered = x.sub(x.mean(.d));
+    const variance = centered.mul(centered).mean(.d);
+    const leveled = centered.div(variance.addConstant(1e-5).sqrt());
+    return leveled.mul(weight.broad(x.shape())).add(bias.broad(x.shape()));
 }
 
