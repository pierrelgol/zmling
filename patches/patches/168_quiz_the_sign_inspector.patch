+/// One convolution of the file: "weight" and "bias" under `view`.
+const Conv = struct {
+    weight: zml.Tensor,
+    bias: zml.Tensor,
+
+    pub fn init(view: zml.io.TensorStore.View) Conv {
+        return .{
+            .weight = view.createReplicatedTensor("weight", .{ .o, .i, .kh, .kw }),
+            .bias = view.createReplicatedTensor("bias", .{.c}),
+        };
+    }
+
+    /// x: {.b, .c, .h, .w} -> {.b, .c, .h, .w}
+    pub fn forward(self: Conv, x: zml.Tensor) zml.Tensor {
+        const y = x.conv2d(self.weight, .{});
+        return y.add(self.bias.broad(y.shape()));
+    }
+};
+
