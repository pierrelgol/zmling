+/// `x`, same dtype, rounded as `dtype` would store it.
+fn asSeenBy(x: zml.Tensor, dtype: zml.DataType) zml.Tensor {
+    return switch (dtype) {
+        .f32 => x,
+        .f16 => x.reducePrecision(5, 10),
+        .bf16 => x.reducePrecision(8, 7),
+        else => @panic("asSeenBy: f32, f16 or bf16"),
+    };
+}
 
+/// w: {.dout, .d}, hands: {.d} -> {.wheel, .d}
+fn movement(w: zml.Tensor, hands: zml.Tensor, weights_dtype: zml.DataType, stream_dtype: zml.DataType) zml.Tensor {
+    const gears = asSeenBy(w, weights_dtype);
+    var stream = asSeenBy(hands, stream_dtype);
+    var after: [wheels]zml.Tensor = undefined;
+    for (&after) |*a| {
+        const nudge = gears.dot(stream, .d).rename(.{ .dout = .d }).tanh().scale(0.05);
+        stream = asSeenBy(stream.add(nudge), stream_dtype);
+        a.* = stream;
+    }
+    return .stack(&after, 0, .wheel);
+}
+
+fn reference(w: zml.Tensor, hands: zml.Tensor) zml.Tensor {
+    return movement(w, hands, .f32, .f32);
+}
+
+fn cheap(w: zml.Tensor, hands: zml.Tensor) zml.Tensor {
+    return movement(w, hands, .bf16, .bf16);
+}
+
+fn mixed(w: zml.Tensor, hands: zml.Tensor) zml.Tensor {
+    return movement(w, hands, .bf16, .f32);
+}
+
+/// The largest |a - b| among the 8 hands after wheel `wheel` (from 0).
+fn worst(a: []const f32, b: []const f32, wheel: usize) f32 {
+    var max: f32 = 0;
+    for (a[wheel * d ..][0..d], b[wheel * d ..][0..d]) |x, y| max = @max(max, @abs(x - y));
+    return max;
+}
+
+/// The first wheel (from 1) where `a` is further than `tolerance` from `b`.
+fn leavesAt(a: []const f32, b: []const f32) ?usize {
+    for (0..wheels) |wheel| {
+        if (worst(a, b, wheel) > tolerance) return wheel + 1;
+    }
+    return null;
+}
