 /// The same, without `rope`. Only for `.hd = 2`: the first number
 /// is the x of the formula, the second one its y.
 fn spinByHand(x: zml.Tensor) zml.Tensor {
-    return ???;
+    const real = x.slice(.hd, .{ .end = 1 });
+    const imag = x.slice(.hd, .{ .start = 1 });
+
+    // One angle per llama: 1 radian per position.
+    const angle = zml.Tensor.arange(.{ .end = x.dim(.s) }, .f32).withTags(.{.s});
+    const cos = angle.cos().broad(real.shape());
+    const sin = angle.sin().broad(real.shape());
+
+    return zml.Tensor.concatenate(&.{
+        real.mul(cos).sub(imag.mul(sin)),
+        real.mul(sin).add(imag.mul(cos)),
+    }, .hd);
 }
 
 /// The score of each listener for each speaker, {.q, .k}, when the
