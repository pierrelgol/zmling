+const Agent = struct {
+    hidden: Layer,
+    output: Layer,
+    doubt: f32,
+
+    pub const Verdict = struct {
+        score: zml.Tensor,
+        alien: zml.Tensor,
+    };
+
+    pub fn forward(self: Agent, x: zml.Tensor) Verdict {
+        const score = self.output.forward(self.hidden.forward(x).relu());
+        return .{
+            .score = score,
+            .alien = score.cmp(.GT, zml.Tensor.scalar(self.doubt, .f32)),
+        };
+    }
+};
 
