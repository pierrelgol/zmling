+/// A full set of weights. Everybody has the same hidden layer.
+fn upload(io: std.Io, platform: *zml.Platform, agent: Agent, out_weight: *const [1][2]f32, out_bias: *const [1]f32) !zml.Bufferized(Agent) {
+    return .{
+        .hidden = .{
+            .weight = try .fromBytes(io, platform, agent.hidden.weight.shape(), std.mem.sliceAsBytes(&hidden_weight)),
+            .bias = try .fromBytes(io, platform, agent.hidden.bias.shape(), std.mem.sliceAsBytes(&hidden_bias)),
+        },
+        .output = .{
+            .weight = try .fromBytes(io, platform, agent.output.weight.shape(), std.mem.sliceAsBytes(out_weight)),
+            .bias = try .fromBytes(io, platform, agent.output.bias.shape(), std.mem.sliceAsBytes(out_bias)),
+        },
+    };
+}
