+        var buf: [64]u8 = undefined;
+        switch (@typeInfo(T)) {
+            .@"struct" => |info| {
+                if (@hasDecl(T, "zml_no_meta_visit")) return;
+                inline for (info.field_names) |name| {
+                    try self.walk(try std.fmt.bufPrint(&buf, "{s}.{s}", .{ path, name }), @field(v, name));
+                }
+            },
+            .array => for (v, 0..) |item, i| {
+                try self.walk(try std.fmt.bufPrint(&buf, "{s}[{d}]", .{ path, i }), item);
+            },
+            .pointer => |info| if (info.size == .slice) {
+                for (v, 0..) |item, i| {
+                    try self.walk(try std.fmt.bufPrint(&buf, "{s}[{d}]", .{ path, i }), item);
+                }
+            },
+            .optional => if (v) |inside| try self.walk(path, inside),
+            else => {},
+        }
+    }
+};
 
